{
  "name": "@grafctory/keep-suite",
  "version": "0.14.2",
  "description": "Connector conformance test suite for @grafctory/keep.",
  "keywords": [
    "typescript",
    "json-ld",
    "model-driven",
    "testing"
  ],
  "homepage": "https://grafctory.github.io/keep/",
  "bugs": {
    "url": "https://github.com/grafctory/keep/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grafctory/keep.git",
    "directory": "packages/components/keep-suite"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@grafctory/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./toys": {
      "@grafctory/source": "./src/toys.ts",
      "default": "./dist/toys.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "ush rm dist docs node_modules",
    "build": "ush rm dist && tsc -p tsconfig.build.json",
    "check": "npx vitest --typecheck run"
  },
  "dependencies": {
    "@grafctory/blue": "^0.15.0",
    "@grafctory/core": "^0.14.0",
    "@grafctory/keep": "^0.14.2",
    "@grafctory/qest": "^0.15.0",
    "@grafctory/trio": "^0.3.0"
  },
  "peerDependencies": {
    "vitest": ">=4.0.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.0.13"
  }
}
