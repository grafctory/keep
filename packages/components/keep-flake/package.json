{
  "name": "@grafctory/keep-flake",
  "version": "0.14.2",
  "description": "Shape-driven traversal trees for @grafctory/keep connectors.",
  "keywords": [
    "typescript",
    "json-ld",
    "model-driven",
    "connector"
  ],
  "homepage": "https://grafctory.github.io/keep/",
