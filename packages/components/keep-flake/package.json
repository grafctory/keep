  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grafctory/keep.git",
    "directory": "packages/components/keep-flake"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@grafctory/source": "./src/index.ts",
