{
  "entryPoints": [
    "packages/*/*"
  ],
  "entryPointStrategy": "packages",
  "plugin": [
    "./typedoc.mjs"
  ],
  "name": "@grafctory/keep",
  "out": "docs",
  "readme": "README.md",
  "hostedBaseUrl": "https://grafctory.github.io/keep/",
  "useFirstParagraphOfCommentAsSummary": true,
  "favicon": "https://metreeca.com/assets/icon.ico",
  "sourceLinkExternal": true,
  "markdownLinkExternal": true,
  "navigationLinks": {
    "GitHub": "https://github.com/grafctory/keep"
  },
  "navigation": {
    "includeGroups": true
  },
  "groupOrder": [
    "Components",
    "Connectors",
    "*"
  ],
  "githubPages": false,
  "hideGenerator": true,
  "customFooterHtml": "<a href='https://www.metreeca.com/' style='display: flex; align-items: center; gap: 0.25em'><img src='https://www.metreeca.com/200.svg' alt='Metreeca' style='width: 1.25em; height: 1.25em;'/><span>Copyright © 2025-2026 Metreeca</span></a>",
  "headings": {
    "readme": false
  },
  "highlightLanguages": [
    "bash",
    "console",
    "css",
    "html",
    "javascript",
    "json",
    "jsonc",
    "mermaid",
    "tsx",
    "typescript",
    "yaml"
  ],
  "externalSymbolLinkMappings": {
    "global": {
      "Error": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Error",
      "RangeError": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/RangeError",
      "TypeError": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/TypeError",
      "fetch": "https://developer.mozilla.org/en-US/docs/Web/API/Window/fetch"
    },
    "@grafctory/blue/union": {
      "getShapeBranches": "https://grafctory.github.io/blue/functions/union.getShapeBranches.html"
    },
    "@grafctory/blue/resource": {
      "PropertyConstraints.foreign": "https://grafctory.github.io/blue/types/resource.PropertyConstraints.html#foreign",
      "PropertyConstraints.captive": "https://grafctory.github.io/blue/types/resource.PropertyConstraints.html#captive"
    },
    "@grafctory/core": {
      "Optional": "https://grafctory.github.io/core/types/index.Optional.html",
      "TraceError": "https://grafctory.github.io/core/classes/trace.TraceError.html"
    },
    "@grafctory/core/trace": {
      "TraceError": "https://grafctory.github.io/core/classes/trace.TraceError.html"
    },
    "@grafctory/core/values": {
      "DeepPartial": "https://grafctory.github.io/core/types/values.DeepPartial.html"
    },
    "@grafctory/http": {
      "Problem": "https://grafctory.github.io/http/types/success.Problem.html"
    },
    "@grafctory/trio": {
      "Term": "https://grafctory.github.io/trio/types/index.Term.html",
      "named": "https://grafctory.github.io/trio/functions/index.named.html",
      "tagged": "https://grafctory.github.io/trio/functions/index.tagged.html",
      "typed": "https://grafctory.github.io/trio/functions/index.typed.html"
    },
    "@grafctory/wire-sparql": {
      "Repository": "https://grafctory.github.io/wire/interfaces/_grafctory_wire-sparql.index.Repository.html",
      "Repository.execute": "https://grafctory.github.io/wire/interfaces/_grafctory_wire-sparql.index.Repository.html#execute",
      "SPARQL": "https://grafctory.github.io/wire/types/_grafctory_wire-sparql.index.SPARQL.html",
      "Tuple": "https://grafctory.github.io/wire/types/_grafctory_wire-sparql.index.Tuple.html"
    }
  },
  "packageOptions": {
    "tsconfig": "./tsconfig.build.json",
    "readme": "none",
    "includeVersion": true,
    "sortEntryPoints": false,
    "sort": [
      "source-order"
    ],
    "categorizeByGroup": true,
    "groupOrder": [
      "Variables",
      "Interfaces",
      "Type Aliases",
      "*"
    ]
  }
}
